{
  "schema": 1,
  "system": "BlackGold Control Plane",
  "channel": "stable",
  "version": "1.6.0",
  "state": "ACTIVE",
  "canonical_repository": "ProjetosCosaNostra/CosaNostra-AI",
  "canonical_path": "control-plane",
  "permanent_installer": "control-plane/install.ps1",
  "latest_descriptor": "control-plane/LATEST.json",
  "project_registry": "control-plane/PROJECT_REGISTRY.json",
  "agent_entrypoint": "control-plane/AGENT_ENTRYPOINT.md",
  "windows_policy": {
    "visible_cmd": "hide",
    "kill_cmd": false,
    "trace_origin": true,
    "automatic_update": true,
    "self_heal": true,
    "doctor": true,
    "doctor_startup_check": true,
    "transactional_install": true,
    "local_rollback": true,
    "preserve_previous_slot": true,
    "commit_pinning": true,
    "git_blob_integrity": true,
    "install_state_tracking": true
  },
  "required_project_markers": [
    "AGENTS.md",
    ".blackgold/control-plane.json"
  ],
  "invariants": [
    "Do not open visible CMD windows for ecosystem automation.",
    "Do not kill required CMD build subprocesses just to hide their windows.",
    "Use the canonical control plane instead of duplicating global execution rules.",
    "New repositories must be registered in PROJECT_REGISTRY.json."
  ],
  "registered_repository_count": 10,
  "github_markers_synced": true,
  "discovery_model": "AGENTS.md + .blackgold/control-plane.json + central PROJECT_REGISTRY.json",
  "security": {
    "public_registry_private_repository_names_omitted": true,
    "authenticated_private_registry_available": true,
    "public_files_must_not_expose_private_repository_names": true
  },
  "stable_branch": "control-plane-stable",
  "release_model": "validated_branch_promotion",
  "runtime_reads_stable_branch_only": true,
  "release_invariant": "main changes are validated before promotion to control-plane-stable",
  "installation_model": "transactional_staging_atomic_swap",
  "rollback_model": "local_last_known_good",
  "integrity_model": "pinned_commit_git_blob_sha1",
  "immutable_downloads": true
}