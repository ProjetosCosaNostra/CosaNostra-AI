{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BlackGold Commander Job",
  "type": "object",
  "required": ["schema", "request_id", "op"],
  "properties": {
    "schema": { "const": 2 },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{6,128}$" },
    "op": {
      "enum": [
        "status",
        "fs_list",
        "fs_read_text",
        "fs_write_text",
        "fs_mkdir",
        "git_status",
        "git_pull_ff",
        "gradle",
        "adb_devices",
        "adb_install",
        "adb_launch_package",
        "emulator_start",
        "logcat_tail"
      ]
    },
    "path": { "type": "string" },
    "project_path": { "type": "string" },
    "content": { "type": "string", "maxLength": 262144 },
    "depth": { "type": "integer", "minimum": 1, "maximum": 5 },
    "max_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
    "task": { "enum": ["assembleDebug", "test", "lint", "connectedDebugAndroidTest"] },
    "apk_path": { "type": "string" },
    "package": { "type": "string" },
    "avd": { "type": "string" },
    "serial": { "type": "string", "pattern": "^emulator-\\d+$" },
    "port": { "type": "integer", "minimum": 5554, "maximum": 5682, "multipleOf": 2 },
    "lines": { "type": "integer", "minimum": 10, "maximum": 2000 },
    "wait_boot_sec": { "type": "integer", "minimum": 1, "maximum": 600 }
  },
  "additionalProperties": false
}
